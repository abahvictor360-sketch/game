# ---------------------------------------------------------------------------
# Fastora: environment variables. Copy to .env.local for local development.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# Public site URL (used for share links and Open Graph images).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs the player session cookie. REQUIRED in production, ≥32 random characters.
# Generate: openssl rand -base64 48
SESSION_SECRET=

# Database. Leave empty locally to use the embedded database in .data/pglite.
# Production: Supabase *transaction pooler* URL (port 6543) for the app,
# and the *session* URL (port 5432) when running `npm run db:migrate`.
# POSTGRES_URL (set by the Supabase ↔ Vercel integration) is accepted as a fallback.
# SSL is enabled automatically for non-local hosts.
DATABASE_URL=
DATABASE_POOL_SIZE=5
# Set to true to run migrations automatically on first connection (not recommended in production).
AUTO_MIGRATE=false

# Supabase Auth (Google + email). When unset, a clearly labelled development
# sign-in is used locally and sign-in is disabled in production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only; used solely to send payload-free Realtime pings for live matches.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated verified emails that receive the admin role on first sign-in.
ADMIN_BOOTSTRAP_EMAILS=

# Secret for the scheduled sweeper (/api/cron/tick). Vercel Cron sends it automatically.
CRON_SECRET=

# Product analytics (PostHog) and error monitoring (Sentry). Optional.
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=

# Development only.
# Force Phase 2 features on regardless of admin settings: multiplayer,ghostOpponents,friendChallenges,askAudience
FEATURE_FLAGS=
# Seed unverified development fixture questions (default: on for the embedded DB only).
SEED_FIXTURES=
# Allow the development sign-in when running `next start` locally (never in production).
ALLOW_DEV_AUTH=

# Shared demo account: sign in as demo@fastora.africa (override with DEMO_ACCOUNT_EMAIL)
# with this password (min 8 chars). Leave empty to disable.
DEMO_ACCOUNT_PASSWORD=
# Allow non-HTTPS cookies when testing a production build on http://localhost.
INSECURE_COOKIES=
